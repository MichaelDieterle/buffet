{
  "version": 2,
  "builds": [
    {
      "src": "src/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "client/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "client/dist",
        "zeroConfig": true
      }
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/src/server.js" },
    { "source": "/mcp(.*)", "destination": "/src/server.js" },
    { "source": "/(.*)", "destination": "/client/dist/index.html" }
  ]
}
