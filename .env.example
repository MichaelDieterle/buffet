# ── Server ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# Comma-separated list of allowed browser origins (CORS)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Required for the admin endpoints (_admin/refresh, _admin/refresh-status)
ADMIN_KEY=change-me

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
# Either set the full connection string…
DATABASE_URL=postgres://user:password@localhost:5432/buffet

# …or individual credentials (takes precedence over DATABASE_URL is not set).
DB_USER=buffet_user
DB_PASS=buffet_password
DB_NAME=buffet
DB_HOST=localhost
DB_PORT=5432
DB_DIALECT=postgres

# ── Market data provider ─────────────────────────────────────────────────────
# Primary provider. Only 'yahoo' is implemented as primary today.
DATA_PROVIDER=yahoo

# Optional fallback provider (used automatically when Yahoo returns no data).
# Get a free key at https://www.alphavantage.co/support/#api-key
# Free tier allows ~25 requests/day.
ALPHA_VANTAGE_API_KEY=

# ── Scheduled refresh job ────────────────────────────────────────────────────
# Cron expression (default: every 15 minutes). Set DISABLE_REFRESH_JOB=true to disable.
REFRESH_CRON=*/15 * * * *
DISABLE_REFRESH_JOB=false
